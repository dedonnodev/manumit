# Copy to .env and fill in. Never commit .env (gitignored).
# Populated by `uv run miband auth-key` (docs/TOKEN.md).

# 16-byte BLE auth key (32 hex chars), used as secretKey in the handshake
# (docs/PROTOCOL.md §3).
MIBAND_AUTH_KEY=

# Band's Bluetooth MAC address, from `miband scan` or auto-filled by
# `miband auth-key`. Optional -- disambiguates if you have multiple BLE
# devices on the account.
MIBAND_MAC=
